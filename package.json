{
  "name": "js-validator",
  "version": "1.0.0",
  "description": "Extract JavaScript from JSP files and validate syntax with ESLint",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check:sample": "node src/cli.js samples/sample.jsp",
